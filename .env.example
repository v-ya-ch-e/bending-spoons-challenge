DB_HOST=your-db-host.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional for Docker Compose and local service routing.
APP_VERSION=0.1.0
ROOT_PATH=/db-api
BACKEND_ROOT_PATH=/api
BACKEND_PORT=8000
DB_REST_API_PORT=8001
FRONTEND_PORT=3000
DB_API_BASE_URL=http://127.0.0.1:8001
OPENAI_API_KEY=your_openai_api_key

# Optional. Used by the backend `GitHubClient` when calling public.github.com. Improves rate limits; required for private repos. Omit for public-only usage with lower limits.
GITHUB_TOKEN=ghp_your_personal_access_token
